{
  "name": "tscw-cli",
  "version": "0.4.3",
  "description": "watch .ts|.js files and then compile it then bundle all module with webpack",
  "main": "index.js",
  "scripts": {
    "webpack-dev": "webpack --mode development",
    "webpack-pro": "webpack --mode production"
  },
  "bin": {
    "tscw": "./index.js"
  },
  "keywords": [
    "cli",
    "es6",
    "es5",
    "js",
    "webpack",
    "watcher",
    "typescript"
  ],
  "homepage": "https://github.com/HosseinMarzban/ned",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosseinMarzban/tscw"
  },
  "author": "Hossein Marzban",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^2.4.1",
    "commander": "^2.18.0",
    "express": "^4.16.3",
    "fs-extra": "^7.0.0",
    "typescript": "^3.1.1",
    "webpack": "^4.20.2"
  },
  "devDependencies": {
    "webpack-cli": "^3.1.2"
  },
  "tscWatcher": {
    "port": "600",
    "watch_dir": "./nedLibrary",
    "publicPath": "./src"
  }
}
