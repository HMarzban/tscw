{
  "name": "tscw-cli",
  "version": "0.4.3",
  "description": "watch .ts|.js files and then compile it then bundle all module with webpack",
  "main": "index.js",
  "scripts": {
    "webpack-dev": "webpack --mode development",
    "webpack-pro": "webpack --mode production"
  },
  "bin": {
    "tscw": "./index.js"
  },
  "keywords": [
    "cli",
    "es6",
    "es5",
    "js",
    "webpack",
    "watcher",
    "typescript"
  ],
  "homepage": "https://github.com/HosseinMarzban/ned",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosseinMarzban/tscw"
  },
  "author": "Hossein Marzban",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^2.4.1",
    "commander": "^2.18.0",
    "express": "^4.22.3",
    "fs-extra": "^7.0.0",
    "typescript": "^3.1.1",
    "webpack": "^4.20.2"
  },
  "devDependencies": {
    "webpack-cli": "^3.1.2"
  },
  "overrides": {
    "acorn@5": "5.7.4",
    "ajv": "6.15.0",
    "ansi-regex": "3.0.1",
    "bn.js": "4.12.5",
    "body-parser": "1.20.8",
    "brace-expansion": "1.1.21",
    "braces": "3.0.3",
    "browserify-sign": "4.2.6",
    "chownr": "1.1.4",
    "cipher-base": "1.0.7",
    "cookie": "0.7.2",
    "cross-spawn": "6.0.6",
    "decode-uri-component": "0.5.0",
    "elliptic": "6.6.1",
    "fsevents": "2.3.3",
    "global-modules-path": "3.0.0",
    "ini": "1.3.8",
    "json5": "1.0.2",
    "kind-of": "6.0.3",
    "loader-utils": "1.4.2",
    "micromatch": "4.0.8",
    "minimatch": "3.1.5",
    "minimist": "1.2.8",
    "mixin-deep": "1.3.2",
    "path-to-regexp": "0.1.13",
    "pbkdf2": "3.1.7",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "semver": "5.7.2",
    "send": "0.19.2",
    "serialize-javascript": "7.1.2",
    "serve-static": "1.16.3",
    "set-value": "2.0.1",
    "sha.js": "2.4.12",
    "ssri": "6.0.2",
    "y18n": "4.0.3",
    "yargs-parser": "13.1.2"
  },
  "tscWatcher": {
    "port": "600",
    "watch_dir": "./nedLibrary",
    "publicPath": "./src"
  }
}
